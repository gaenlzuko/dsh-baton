{
  "name": "dsh-baton-native",
  "version": "0.1.0",
  "private": true,
  "description": "Native DSH tools for dsh-baton: hand a task to an independent Harness session and get an evidence-backed result back.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "PLAN.md"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
